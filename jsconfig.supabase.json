{
 "compilerOptions": {
  "allowJs": true,
  "checkJs": true,
  "noEmit": true,
  "skipLibCheck": true,
  "strict": false,
  "baseUrl": ".",
  "paths": {"@/*": ["src/*"]},
  "jsx": "react-jsx",
  "module": "esnext",
  "moduleResolution": "bundler",
  "target": "es2022",
  "lib": ["es2022","dom"],
  "types": ["vite/client"]
 },
 "include": ["src/supabase/**/*.jsx","src/api/supabaseClient.js"],
 "exclude": ["node_modules","src/pages","src/components","src/lib"]
}
