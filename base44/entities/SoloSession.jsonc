{
  "name": "SoloSession",
  "type": "object",
  "properties": {
    "session_type": {
      "type": "string",
      "enum": [
        "solo_session",
        "service_booking",
        "location_booking"
      ],
      "default": "solo_session"
    },
    "booking_mode": {
      "type": "string",
      "enum": [
        "solo",
        "collaboration"
      ],
      "default": "solo"
    },
    "participant_mode": {
      "type": "string",
      "enum": [
        "on_platform",
        "external",
        "mixed"
      ],
      "default": "on_platform"
    },
    "host_user_id": {
      "type": "string"
    },
    "guest_user_id": {
      "type": "string"
    },
    "external_participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_host",
        "confirmed",
        "contract_pending",
        "contract_signed",
        "active",
        "completed",
        "cancelled",
        "disputed"
      ],
      "default": "draft"
    },
    "session_name": {
      "type": "string"
    },
    "schedule": {
      "type": "object",
      "properties": {
        "confirmed_date": {
          "type": "string",
          "format": "date"
        },
        "start_time": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        },
        "duration_hours": {
          "type": "number"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "studio",
            "private",
            "outdoor",
            "travel"
          ]
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "compensation": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "payment_type": {
          "type": "string",
          "enum": [
            "fixed",
            "hourly",
            "deposit_only",
            "free"
          ]
        },
        "deposit_amount": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "booking_snapshot": {
      "type": "object",
      "description": "Immutable snapshot of add-ons, bundle, and pricing captured at booking time. Never mutated after creation.",
      "properties": {
        "property_id": {
          "type": "string"
        },
        "bundle_id": {
          "type": "string",
          "description": "Selected bundle ID from property.bundles[]"
        },
        "bundle_name": {
          "type": "string",
          "description": "Bundle name at time of booking"
        },
        "selected_equipment": {
          "type": "array",
          "description": "Rentable equipment items the guest selected",
          "items": {
            "type": "object",
            "properties": {
              "equipment_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "rental_price": {
                "type": "number"
              },
              "deposit_amount": {
                "type": "number"
              },
              "liability_ack": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "pricing_breakdown": {
          "type": "object",
          "description": "Line-item pricing snapshot for audit/contract display",
          "properties": {
            "base_rate": {
              "type": "number"
            },
            "base_rate_type": {
              "type": "string"
            },
            "hours": {
              "type": "number"
            },
            "bundle_modifier": {
              "type": "number"
            },
            "equipment_total": {
              "type": "number"
            },
            "cleaning_fee": {
              "type": "number"
            },
            "deposit_total": {
              "type": "number"
            },
            "grand_total": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "default": "USD"
            }
          }
        },
        "liability_acks": {
          "type": "array",
          "description": "Each liability acknowledgment the guest accepted at booking",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string"
              },
              "item_name": {
                "type": "string"
              },
              "liability_text": {
                "type": "string"
              },
              "accepted_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "buffers": {
          "type": "object",
          "description": "Buffer hours snapshotted at booking time",
          "properties": {
            "setup_buffer_hours": {
              "type": "number"
            },
            "teardown_buffer_hours": {
              "type": "number"
            },
            "cleaning_buffer_hours": {
              "type": "number"
            }
          }
        }
      }
    },
    "contract_id": {
      "type": "string"
    },
    "booking_request_id": {
      "type": "string"
    },
    "schedule_entry_id": {
      "type": "string"
    },
    "collaboration_id": {
      "type": "string"
    },
    "upgraded_to_collaboration": {
      "type": "boolean",
      "default": false
    },
    "internal_notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_checkin_id": {
      "type": "string"
    },
    "agreement_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "agreement_text_snapshot": {
      "type": "string"
    }
  },
  "required": [
    "session_type",
    "booking_mode",
    "host_user_id",
    "guest_user_id",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "data.guest_user_id": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.guest_user_id": "{{user.email}}"
        },
        {
          "data.host_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.guest_user_id": "{{user.email}}"
        },
        {
          "data.host_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}