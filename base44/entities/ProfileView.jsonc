{
  "name": "ProfileView",
  "type": "object",
  "properties": {
    "profile_owner_id": {
      "type": "string"
    },
    "viewer_user_id": {
      "type": "string"
    },
    "viewed_date": {
      "type": "string",
      "format": "date"
    },
    "view_type": {
      "type": "string",
      "enum": [
        "profile",
        "gallery"
      ],
      "default": "profile"
    }
  },
  "required": [
    "profile_owner_id",
    "viewer_user_id",
    "viewed_date"
  ],
  "rls": {
    "create": {
      "data.viewer_user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.profile_owner_id": "{{user.email}}"
        },
        {
          "data.viewer_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}