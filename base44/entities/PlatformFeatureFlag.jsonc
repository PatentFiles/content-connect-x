{
  "name": "PlatformFeatureFlag",
  "type": "object",
  "properties": {
    "flag_key": {
      "type": "string",
      "description": "Unique identifier for this flag (e.g. 'messaging', 'comm_filter', 'pro_host_tier')"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label shown in admin UI"
    },
    "description": {
      "type": "string",
      "description": "What this flag controls"
    },
    "category": {
      "type": "string",
      "enum": [
        "core",
        "marketplace",
        "safety",
        "compliance",
        "experimental"
      ],
      "default": "core",
      "description": "Grouping category for admin UI"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "boolean",
        "number",
        "text"
      ],
      "default": "boolean",
      "description": "Data type of this flag's value"
    },
    "bool_value": {
      "type": "boolean",
      "default": true,
      "description": "Value when value_type=boolean"
    },
    "number_value": {
      "type": "number",
      "description": "Value when value_type=number"
    },
    "text_value": {
      "type": "string",
      "description": "Value when value_type=text"
    },
    "affects_nav": {
      "type": "boolean",
      "default": false,
      "description": "When true and bool_value=false, the associated nav page(s) are hidden"
    },
    "nav_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Page names to hide from sidebar/bottom nav when this flag is disabled"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "System flags cannot be deleted, only toggled"
    }
  },
  "required": [
    "flag_key",
    "label",
    "value_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}