{
  "name": "CustomCity",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "description": "State code (e.g., CA, NY)"
    },
    "city_name": {
      "type": "string",
      "description": "Name of the city"
    },
    "added_by": {
      "type": "string",
      "description": "User who added this city"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the city has been verified as real"
    }
  },
  "required": [
    "state",
    "city_name",
    "added_by"
  ],
  "rls": {
    "create": {
      "data.added_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.verified": true
        },
        {
          "data.added_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}