{
  "name": "AgentRepresentation",
  "type": "object",
  "properties": {
    "agent_user_id": {
      "type": "string",
      "description": "Agent's user ID"
    },
    "creator_user_id": {
      "type": "string",
      "description": "Creator's user ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "INVITED",
        "ACTIVE",
        "DECLINED",
        "ENDED"
      ],
      "default": "DRAFT",
      "description": "Representation lifecycle status"
    },
    "agreement_notes": {
      "type": "string",
      "description": "Terms and notes shared with the invite"
    },
    "commission_rate": {
      "type": "number",
      "description": "Agent commission percentage (e.g. 15 = 15%)"
    },
    "exclusivity": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is an exclusive representation arrangement"
    },
    "permissions": {
      "type": "object",
      "description": "Permissions granted to agent",
      "properties": {
        "can_negotiate": {
          "type": "boolean",
          "default": true
        },
        "can_sign_contracts": {
          "type": "boolean",
          "default": false
        },
        "can_message": {
          "type": "boolean",
          "default": true
        },
        "can_view_private_gallery": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When representation became active"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When representation ended"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator declined the invite"
    },
    "decline_reason": {
      "type": "string",
      "description": "Optional reason provided by creator when declining"
    }
  },
  "required": [
    "agent_user_id",
    "creator_user_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.agent_user_id": "{{user.email}}"
        },
        {
          "data.creator_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.agent_user_id": "{{user.email}}"
        },
        {
          "data.creator_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.agent_user_id": "{{user.email}}"
        },
        {
          "data.creator_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.agent_user_id": "{{user.email}}"
        },
        {
          "data.creator_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}