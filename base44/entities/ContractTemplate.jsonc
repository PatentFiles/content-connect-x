{
  "name": "ContractTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "category": {
      "type": "string",
      "enum": [
        "custom",
        "creator_to_creator",
        "studio_contract",
        "photographer_contract",
        "videographer_contract",
        "agent_managed"
      ],
      "default": "custom",
      "description": "Template category"
    },
    "applicable_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "creator_to_creator",
          "studio_contract",
          "photographer_contract",
          "videographer_contract",
          "agent_managed"
        ]
      },
      "description": "Which collaboration contexts this template applies to. Empty = universal.",
      "default": []
    },
    "description": {
      "type": "string",
      "description": "Template description"
    },
    "content": {
      "type": "string",
      "description": "Template content with {{token}} placeholders"
    },
    "token_schema": {
      "type": "object",
      "description": "Token definitions: { token_key: { label, required, hint, type, enum? } }"
    },
    "allowed_edit_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fields users can edit in generated contracts"
    },
    "created_by": {
      "type": "string",
      "description": "Creator of template"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a default platform template"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether template is available for use"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Template version number \u2014 increment on significant content changes"
    }
  },
  "required": [
    "name",
    "content",
    "created_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}