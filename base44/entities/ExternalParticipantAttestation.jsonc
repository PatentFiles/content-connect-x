{
  "name": "ExternalParticipantAttestation",
  "type": "object",
  "description": "Attestation record for off-platform participants in a session. The booking user (host/producer) attests that all legal/consent requirements have been met. Never marks external participants as platform-verified.",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "SoloSession this attestation covers"
    },
    "attesting_user_id": {
      "type": "string",
      "description": "Platform user who submitted this attestation (must be host or guest on the session)"
    },
    "attesting_user_role": {
      "type": "string",
      "enum": [
        "host",
        "guest",
        "producer",
        "studio"
      ],
      "description": "Role of the attesting user in this session"
    },
    "participants": {
      "type": "array",
      "description": "List of external participants covered by this attestation",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "e.g. talent, crew, model, performer"
          },
          "id_type_verified": {
            "type": "string",
            "enum": [
              "government_id",
              "passport",
              "drivers_license",
              "other"
            ],
            "description": "What type of ID was checked \u2014 not the ID itself"
          }
        }
      }
    },
    "attestations": {
      "type": "object",
      "description": "Specific attestation checkboxes the booking user confirmed",
      "properties": {
        "all_participants_18_plus": {
          "type": "boolean",
          "default": false,
          "description": "All listed participants are 18 years of age or older"
        },
        "ids_checked": {
          "type": "boolean",
          "default": false,
          "description": "Valid government-issued photo ID was examined for each participant"
        },
        "consent_obtained": {
          "type": "boolean",
          "default": false,
          "description": "Informed consent was obtained from each participant for activities in this session"
        },
        "records_maintained": {
          "type": "boolean",
          "default": false,
          "description": "Copies of ID and consent documentation are retained per applicable laws"
        },
        "applicable_laws_followed": {
          "type": "boolean",
          "default": false,
          "description": "All applicable local, state, and federal laws governing this production have been followed"
        },
        "no_platform_verification_claimed": {
          "type": "boolean",
          "default": false,
          "description": "Booking user acknowledges external participants are NOT platform-verified and the platform makes no representation about their identity or age"
        }
      }
    },
    "attestation_text_snapshot": {
      "type": "string",
      "description": "Full attestation text shown to the user at the time of submission \u2014 immutable"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "admin_reviewed": {
      "type": "boolean",
      "default": false
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "attesting_user_id",
    "attesting_user_role",
    "submitted_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.attesting_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.attesting_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}