{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to auth user"
    },
    "real_name": {
      "type": "string",
      "description": "Real legal name - only visible to admins"
    },
    "display_name": {
      "type": "string",
      "description": "Stage name or business name"
    },
    "age": {
      "type": "number",
      "description": "User's age"
    },
    "ethnicity": {
      "type": "string",
      "description": "User's ethnicity/race"
    },
    "bio": {
      "type": "string",
      "description": "Profile bio (may contain HTML from rich text editor)"
    },
    "role_type": {
      "type": "string",
      "enum": [
        "creator",
        "photographer",
        "videographer",
        "video_editor",
        "agent",
        "studio",
        "admin"
      ],
      "description": "Account type"
    },
    "is_admin": {
      "type": "boolean",
      "default": false,
      "description": "Admin access flag"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "cover_url": {
      "type": "string",
      "description": "Cover image URL"
    },
    "profile_theme": {
      "type": "string",
      "enum": [
        "default",
        "midnight",
        "sunset",
        "ocean",
        "forest",
        "neon",
        "gold",
        "arctic"
      ],
      "default": "default",
      "description": "Banner gradient theme when no cover image"
    },
    "base_location": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "travel_enabled": {
      "type": "boolean",
      "default": false
    },
    "travel_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "travel_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "arrival_time": {
            "type": "string"
          }
        }
      }
    },
    "availability_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Dates the user is available for collaborations"
    },
    "visibility_settings": {
      "type": "object",
      "properties": {
        "show_stats": {
          "type": "boolean",
          "default": false
        },
        "show_location": {
          "type": "boolean",
          "default": true
        },
        "show_travel": {
          "type": "boolean",
          "default": true
        },
        "show_online_status": {
          "type": "boolean",
          "default": true
        },
        "profile_visibility": {
          "type": "string",
          "enum": [
            "verified_members",
            "subscribers_only"
          ],
          "default": "verified_members"
        }
      }
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time"
    },
    "response_time_hours": {
      "type": "number",
      "description": "Average response time in hours"
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    },
    "primary_representation_type": {
      "type": "string",
      "enum": [
        "agent",
        "studio"
      ],
      "description": "Primary representation type for creators"
    },
    "primary_representation_id": {
      "type": "string",
      "description": "ID of primary representation relationship"
    },
    "allow_direct_contact_while_represented": {
      "type": "boolean",
      "default": true,
      "description": "Whether to allow direct contact from others while represented"
    },
    "banned": {
      "type": "boolean",
      "default": false,
      "description": "Account permanently banned"
    },
    "suspended": {
      "type": "boolean",
      "default": false,
      "description": "Account temporarily suspended"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Reason for suspension (visible to user)"
    },
    "suspension_category": {
      "type": "string",
      "enum": [
        "policy_violation",
        "safety_review",
        "identity_review",
        "content_violation",
        "solicitation",
        "spam",
        "other"
      ],
      "description": "Category of suspension reason"
    },
    "suspension_start_at": {
      "type": "string",
      "format": "date-time",
      "description": "When suspension started"
    },
    "suspension_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "When suspension expires (null = indefinite)"
    },
    "reinstated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When account was reinstated from suspension"
    },
    "reinstated_by_admin_id": {
      "type": "string",
      "description": "Admin who reinstated the account"
    },
    "on_probation": {
      "type": "boolean",
      "default": false,
      "description": "Account reinstated but under probation restrictions"
    },
    "probation_restrictions": {
      "type": "object",
      "description": "Feature flags for probation mode",
      "properties": {
        "restricted_messaging": {
          "type": "boolean",
          "default": false
        },
        "no_hosting": {
          "type": "boolean",
          "default": false
        },
        "no_accelerated_payouts": {
          "type": "boolean",
          "default": false
        },
        "elevated_moderation": {
          "type": "boolean",
          "default": false
        },
        "probation_end_at": {
          "type": "string",
          "format": "date-time"
        },
        "probation_notes": {
          "type": "string"
        }
      }
    },
    "legal_hold": {
      "type": "boolean",
      "default": false,
      "description": "Prevents account deletion when under legal review"
    },
    "deletion_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user first requested account deletion"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When account was anonymized/deactivated"
    },
    "deletion_status": {
      "type": "string",
      "enum": [
        "requested",
        "blocked_legal_hold",
        "anonymized",
        "completed"
      ],
      "description": "Current stage of the deletion lifecycle"
    },
    "deletion_reason_internal": {
      "type": "string",
      "description": "Internal admin notes about the deletion (not shown to user)"
    },
    "account_deactivated": {
      "type": "boolean",
      "default": false,
      "description": "True when the account has been anonymized and hidden from public discovery"
    }
  },
  "required": [
    "user_id",
    "role_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.user_id": "{{user.email}}"
            },
            {
              "not": {
                "has_banned_or_suspended": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}