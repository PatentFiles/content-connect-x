{
  "name": "ContractSignature",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "signer_id": {
      "type": "string"
    },
    "signer_name": {
      "type": "string"
    },
    "signer_role": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_data": {
      "type": "string",
      "description": "Base64 signature image or typed name"
    },
    "signature_type": {
      "type": "string",
      "enum": [
        "drawn",
        "typed",
        "uploaded"
      ]
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "signer_id",
    "signature_data"
  ],
  "rls": {
    "create": {
      "data.signer_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.signer_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}