{
  "name": "QuickTask",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Task owner's user ID"
    },
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "DONE"
      ],
      "default": "OPEN",
      "description": "Task status"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Task due date"
    },
    "related_type": {
      "type": "string",
      "enum": [
        "DEAL_ROOM",
        "CONTRACT",
        "MESSAGE",
        "PROFILE",
        "VERIFICATION"
      ],
      "description": "Related entity type"
    },
    "related_id": {
      "type": "string",
      "description": "Related entity ID"
    }
  },
  "required": [
    "user_id",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}