{
  "name": "AgentRun",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Reference to AgentProfile"
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "MANUAL",
        "SCHEDULED",
        "EVENT"
      ],
      "default": "MANUAL",
      "description": "How the run was triggered"
    },
    "triggered_by_user_id": {
      "type": "string",
      "description": "User who triggered manual run"
    },
    "run_status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "FAILED"
      ],
      "default": "QUEUED",
      "description": "Current status of the run"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When run started"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When run completed"
    },
    "input_summary": {
      "type": "string",
      "description": "Summary of input parameters"
    },
    "output_summary": {
      "type": "string",
      "description": "Summary of results"
    },
    "metadata_json": {
      "type": "object",
      "description": "Additional run metadata"
    }
  },
  "required": [
    "agent_id",
    "triggered_by"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}