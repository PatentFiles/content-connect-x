{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique coupon code (uppercase)"
    },
    "description": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "PERCENT",
        "FIXED",
        "FREE_MONTHS"
      ]
    },
    "discount_value": {
      "type": "number",
      "description": "Percentage (1-100), fixed amount, or months count"
    },
    "applies_to_role_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of role types or ['ALL']"
    },
    "applies_to_plan_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of plan IDs or ['ALL']"
    },
    "max_redemptions_total": {
      "type": "number",
      "description": "Max total uses (null = unlimited)"
    },
    "max_redemptions_per_user": {
      "type": "number",
      "description": "Max uses per user (null = unlimited)"
    },
    "redeemed_count": {
      "type": "number",
      "default": 0
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_by_admin_id": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}