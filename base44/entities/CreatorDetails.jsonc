  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}