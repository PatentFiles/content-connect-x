{
  "name": "GalleryComment",
  "type": "object",
  "properties": {
    "gallery_id": {
      "type": "string"
    },
    "item_index": {
      "type": "number"
    },
    "profile_owner_id": {
      "type": "string"
    },
    "commenter_user_id": {
      "type": "string"
    },
    "commenter_display_name": {
      "type": "string"
    },
    "commenter_avatar_url": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "gallery_id",
    "item_index",
    "profile_owner_id",
    "commenter_user_id",
    "content"
  ],
  "rls": {
    "create": {
      "data.commenter_user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.commenter_user_id": "{{user.email}}"
        },
        {
          "data.profile_owner_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.commenter_user_id": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.commenter_user_id": "{{user.email}}"
        },
        {
          "data.profile_owner_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}