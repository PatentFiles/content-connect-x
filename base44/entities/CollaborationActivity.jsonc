{
  "name": "CollaborationActivity",
  "type": "object",
  "properties": {
    "collaboration_id": {
      "type": "string",
      "description": "Collaboration ID"
    },
    "user_id": {
      "type": "string",
      "description": "User who performed the action"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "created",
        "status_changed",
        "task_added",
        "task_completed",
        "document_uploaded",
        "event_scheduled",
        "member_added",
        "comment_added",
        "contract_sent",
        "message_sent",
        "dispute_opened",
        "dispute_updated",
        "confirmation_submitted",
        "role_changed"
      ],
      "description": "Type of activity"
    },
    "description": {
      "type": "string",
      "description": "Activity description"
    },
    "metadata": {
      "type": "object",
      "description": "Additional activity data"
    }
  },
  "required": [
    "collaboration_id",
    "user_id",
    "activity_type",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {},
    "delete": {}
  }
}