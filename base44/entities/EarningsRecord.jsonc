{
  "name": "EarningsRecord",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this earnings record belongs to"
    },
    "collaboration_id": {
      "type": "string",
      "description": "Associated collaboration"
    },
    "contract_id": {
      "type": "string",
      "description": "Associated contract"
    },
    "type": {
      "type": "string",
      "enum": [
        "projected",
        "confirmed",
        "commission_paid",
        "commission_received"
      ],
      "description": "Earnings type"
    },
    "gross_amount": {
      "type": "number",
      "description": "Total collaboration value (if known)"
    },
    "net_amount": {
      "type": "number",
      "description": "This user's share after splits"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "split_percentage": {
      "type": "number",
      "description": "User's revenue split %"
    },
    "agent_commission_rate": {
      "type": "number",
      "description": "Agent's commission % (if represented)"
    },
    "studio_split_rate": {
      "type": "number",
      "description": "Studio split % (if represented)"
    },
    "collaboration_type": {
      "type": "string",
      "description": "Type of collaboration for categorization"
    },
    "settlement_status": {
      "type": "string",
      "enum": [
        "projected",
        "pending_settlement",
        "settled",
        "disputed"
      ],
      "default": "projected"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Manual settlement notes"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "agent_visible",
        "studio_visible"
      ],
      "default": "private"
    }
  },
  "required": [
    "user_id",
    "collaboration_id",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}