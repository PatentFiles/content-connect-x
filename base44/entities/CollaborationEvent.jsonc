{
  "name": "CollaborationEvent",
  "type": "object",
  "properties": {
    "collaboration_id": {
      "type": "string",
      "description": "Collaboration ID"
    },
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Event start date/time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Event end date/time"
    },
    "location": {
      "type": "string",
      "description": "Event location"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "meeting",
        "shoot",
        "call",
        "deadline",
        "other"
      ],
      "default": "meeting",
      "description": "Event type"
    },
    "created_by": {
      "type": "string",
      "description": "User ID of creator"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of attendees"
    }
  },
  "required": [
    "collaboration_id",
    "title",
    "start_date",
    "end_date",
    "created_by"
  ],
  "rls": {
    "create": {
      "data.created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "data.attendees": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}