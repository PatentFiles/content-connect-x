{
  "name": "ServiceDetails",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "photography",
        "videography",
        "both"
      ]
    },
    "age": {
      "type": "number"
    },
    "gender_identity": {
      "type": "string",
      "enum": [
        "woman",
        "man",
        "trans_woman",
        "trans_man",
        "non_binary"
      ]
    },
    "content_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gay",
          "straight",
          "trans"
        ]
      },
      "description": "Types of content they film"
    },
    "acts_filmed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Acts they film"
    },
    "availability_type": {
      "type": "string",
      "enum": [
        "local_only",
        "available_for_travel"
      ],
      "description": "Travel availability"
    },
    "rates": {
      "type": "object",
      "properties": {
        "hourly": {
          "type": "number"
        },
        "half_day": {
          "type": "number"
        },
        "full_day": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "deliverables": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          }
        }
      }
    },
    "gear_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "portfolio_public": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "portfolio_private": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "travel_fee_info": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "service_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}