{
  "name": "TestingCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "status_badge": {
      "type": "string",
      "enum": [
        "valid",
        "expired",
        "pending_review"
      ],
      "default": "pending_review"
    },
    "tested_at": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "docs_private_url": {
      "type": "string"
    },
    "share_settings": {
      "type": "object",
      "properties": {
        "show_badge_publicly": {
          "type": "boolean",
          "default": true
        },
        "share_with_deal_participants": {
          "type": "boolean",
          "default": false
        },
        "share_full_document": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "verified_by_admin": {
      "type": "boolean",
      "default": false
    },
    "submitted_for_collaboration_id": {
      "type": "string",
      "description": "Optional collaboration ID if uploaded for specific collaboration"
    }
  },
  "required": [
    "user_id",
    "status_badge"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}