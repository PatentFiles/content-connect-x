{
  "name": "Property",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Platform user who owns/hosts this property"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "individual",
        "studio",
        "agency",
        "production_company"
      ],
      "default": "individual",
      "description": "Type of property owner. Studios and agencies are valid hosts \u2014 no separate system needed."
    },
    "property_type": {
      "type": "string",
      "enum": [
        "studio",
        "loft",
        "house",
        "apartment",
        "studio_set",
        "dungeon",
        "warehouse",
        "hotel_suite",
        "dedicated_content_house",
        "commercial_space",
        "rooftop",
        "outdoor",
        "office",
        "other"
      ],
      "default": "studio",
      "description": "Category of property \u2014 drives rule presets and discovery filtering"
    },
    "title": {
      "type": "string",
      "description": "Public display title"
    },
    "description": {
      "type": "string",
      "description": "Public description (may contain HTML)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "active",
        "paused",
        "suspended",
        "archived"
      ],
      "default": "draft",
      "description": "Listing lifecycle status"
    },
    "city": {
      "type": "string",
      "description": "Public city \u2014 shown to all verified users"
    },
    "state": {
      "type": "string",
      "description": "Public state/region"
    },
    "country": {
      "type": "string",
      "default": "US"
    },
    "exact_address": {
      "type": "string",
      "description": "Full address \u2014 PRIVATE. Only revealed after confirmed booking."
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "caption": {
            "type": "string"
          },
          "is_cover": {
            "type": "boolean",
            "default": false
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "properties": {
        "max_people": {
          "type": "number"
        },
        "rooms": {
          "type": "number"
        },
        "sq_ft": {
          "type": "number"
        }
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "hourly_rate": {
          "type": "number"
        },
        "half_day_rate": {
          "type": "number"
        },
        "full_day_rate": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "minimum_hours": {
          "type": "number",
          "default": 1
        },
        "deposit_required": {
          "type": "boolean",
          "default": false
        },
        "deposit_amount": {
          "type": "number"
        },
        "pricing_notes": {
          "type": "string"
        }
      }
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "object",
      "description": "Structured property rules \u2014 preset by property_type, fully customizable by host",
      "properties": {
        "max_people": {
          "type": "number",
          "description": "Hard cap on simultaneous occupants"
        },
        "verified_only": {
          "type": "boolean",
          "default": true
        },
        "no_smoking": {
          "type": "boolean",
          "default": true
        },
        "no_alcohol": {
          "type": "boolean",
          "default": false
        },
        "music_allowed": {
          "type": "boolean",
          "default": true
        },
        "quiet_hours_start": {
          "type": "string",
          "description": "HH:MM \u2014 start of quiet period"
        },
        "quiet_hours_end": {
          "type": "string",
          "description": "HH:MM \u2014 end of quiet period"
        },
        "no_outside_vendors": {
          "type": "boolean",
          "default": false
        },
        "no_outside_filming_equipment": {
          "type": "boolean",
          "default": false,
          "description": "Outside filming equipment prohibited"
        },
        "no_window_visibility": {
          "type": "boolean",
          "default": false,
          "description": "No content near windows/public visibility"
        },
        "no_overnight": {
          "type": "boolean",
          "default": true,
          "description": "Overnight stays prohibited"
        },
        "furniture_movement_allowed": {
          "type": "boolean",
          "default": false,
          "description": "Guests may move furniture"
        },
        "cleanup_required": {
          "type": "boolean",
          "default": true,
          "description": "Guests responsible for cleanup"
        },
        "parking_available": {
          "type": "boolean",
          "default": false
        },
        "parking_notes": {
          "type": "string"
        },
        "security_cameras_present": {
          "type": "boolean",
          "default": false,
          "description": "Security cameras are present on premises (disclosure)"
        },
        "security_camera_notes": {
          "type": "string",
          "description": "Location/scope of cameras if present"
        },
        "equipment_use_allowed": {
          "type": "boolean",
          "default": true,
          "description": "Guests may use in-house equipment"
        },
        "equipment_use_notes": {
          "type": "string",
          "description": "Specific restrictions on equipment use"
        },
        "restricted_content": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Content types/acts not permitted on premises"
        },
        "special_restrictions": {
          "type": "string",
          "description": "Free-text additional restrictions"
        },
        "custom_rules": {
          "type": "string",
          "description": "Catch-all free-text for anything not covered above"
        }
      }
    },
    "availability_notes": {
      "type": "string"
    },
    "instant_book": {
      "type": "boolean",
      "default": false
    },
    "onboarding_checklist": {
      "type": "object",
      "properties": {
        "photos_uploaded": {
          "type": "boolean",
          "default": false
        },
        "pricing_set": {
          "type": "boolean",
          "default": false
        },
        "rules_set": {
          "type": "boolean",
          "default": false
        },
        "address_verified": {
          "type": "boolean",
          "default": false
        },
        "agreement_accepted": {
          "type": "boolean",
          "default": false
        },
        "host_doc_uploaded": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "host_doc_uri": {
      "type": "string"
    },
    "agreement_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_bookings": {
      "type": "number",
      "default": 0
    },
    "average_rating": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "internal_notes": {
      "type": "string"
    },
    "flagged": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "owner_user_id",
    "property_type",
    "title",
    "city",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "data.status": "active"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}