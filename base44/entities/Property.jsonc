{
  "name": "Property",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Platform user who owns/hosts this property"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "individual",
        "studio",
        "agency",
        "production_company"
      ],
      "default": "individual"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "studio",
        "loft",
        "house",
        "apartment",
        "studio_set",
        "dungeon",
        "warehouse",
        "hotel_suite",
        "dedicated_content_house",
        "commercial_space",
        "rooftop",
        "outdoor",
        "office",
        "other"
      ],
      "default": "studio"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "active",
        "paused",
        "suspended",
        "archived"
      ],
      "default": "draft"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "US"
    },
    "exact_address": {
      "type": "string",
      "description": "PRIVATE. Only revealed after confirmed booking."
    },
    "lat": {
      "type": "number",
      "description": "PRIVATE. Used for geofence/GPS check-in only."
    },
    "lng": {
      "type": "number",
      "description": "PRIVATE. Used for geofence/GPS check-in only."
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "caption": {
            "type": "string"
          },
          "is_cover": {
            "type": "boolean",
            "default": false
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "properties": {
        "max_people": {
          "type": "number"
        },
        "rooms": {
          "type": "number"
        },
        "sq_ft": {
          "type": "number"
        }
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "hourly_rate": {
          "type": "number"
        },
        "half_day_rate": {
          "type": "number"
        },
        "full_day_rate": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "minimum_hours": {
          "type": "number",
          "default": 1
        },
        "deposit_required": {
          "type": "boolean",
          "default": false
        },
        "deposit_amount": {
          "type": "number"
        },
        "pricing_notes": {
          "type": "string"
        },
        "cleaning_fee_enabled": {
          "type": "boolean",
          "default": false
        },
        "cleaning_fee_amount": {
          "type": "number"
        }
      }
    },
    "damage_deposit": {
      "type": "object",
      "description": "Host-configured damage deposit. Feature-gated by damage_deposits flag.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether a damage deposit is required for this property"
        },
        "amount": {
          "type": "number",
          "description": "Damage deposit amount in USD"
        },
        "refund_window_days": {
          "type": "number",
          "default": 7,
          "description": "Days after checkout within which the deposit must be refunded or disputed"
        },
        "policy_notes": {
          "type": "string",
          "description": "Host-written deposit policy shown to guests before booking"
        },
        "collection_method": {
          "type": "string",
          "enum": [
            "platform",
            "direct",
            "credit_card_hold"
          ],
          "default": "platform",
          "description": "How the deposit is collected. 'platform' = future payment integration; 'direct' = host collects separately."
        }
      }
    },
    "buffers": {
      "type": "object",
      "properties": {
        "setup_buffer_hours": {
          "type": "number",
          "default": 0
        },
        "teardown_buffer_hours": {
          "type": "number",
          "default": 0
        },
        "cleaning_buffer_hours": {
          "type": "number",
          "default": 0
        }
      }
    },
    "access_settings": {
      "type": "object",
      "description": "Host-configured access and check-in preferences for this property",
      "properties": {
        "gps_checkin_required": {
          "type": "boolean",
          "default": false,
          "description": "Whether GPS check-in is required at this property (only active when global gps_checkin flag is on)"
        },
        "gps_geofence_radius_meters": {
          "type": "number",
          "default": 200,
          "description": "Radius from property lat/lng that counts as 'on-site'. Default 200m."
        },
        "access_code_window_minutes_before": {
          "type": "number",
          "default": 30,
          "description": "How many minutes before booking start the access code becomes active"
        },
        "access_code_window_minutes_after": {
          "type": "number",
          "default": 15,
          "description": "How many minutes after booking end the code remains valid (grace period)"
        },
        "smart_lock_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether this property has a smart/API-connected lock configured"
        },
        "smart_lock_provider": {
          "type": "string",
          "enum": [
            "manual",
            "august",
            "schlage",
            "yale",
            "nuki",
            "igloohome",
            "remotelock",
            "other"
          ],
          "default": "manual",
          "description": "Lock provider for API integration. 'manual' = host sets code manually."
        },
        "smart_lock_config": {
          "type": "object",
          "description": "Provider-specific config (account IDs, device IDs). PRIVATE \u2014 admin/host only.",
          "properties": {
            "device_id": {
              "type": "string"
            },
            "account_ref": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "checkout_evidence_required": {
          "type": "boolean",
          "default": false,
          "description": "Whether checkout evidence upload is requested from guest/host"
        }
      }
    },
    "geo_risk": {
      "type": "object",
      "description": "Admin-set geographic and contextual risk metadata. Used to influence moderation review strictness, reserve %, ranking, and trust signals. Never shown to guests directly.",
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "flagged"
          ],
          "default": "low",
          "description": "Overall risk classification for this property"
        },
        "jurisdiction_notes": {
          "type": "string",
          "description": "Admin notes on local laws, permit requirements, or zoning constraints"
        },
        "requires_manual_review": {
          "type": "boolean",
          "default": false,
          "description": "If true, all bookings at this property require admin pre-approval"
        },
        "reserve_pct_override": {
          "type": "number",
          "description": "Override the payout reserve % for this property (e.g. 10 = 10%). Null = use platform default."
        },
        "ranking_penalty": {
          "type": "number",
          "default": 0,
          "description": "Points subtracted from discovery ranking score (0 = no penalty)"
        },
        "risk_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Admin-assigned risk signal tags, e.g. ['no_permit', 'prior_incidents', 'jurisdiction_restricted']"
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date-time",
          "description": "When admin last reviewed geo risk for this property"
        },
        "reviewed_by_admin_id": {
          "type": "string"
        }
      }
    },
    "insurance": {
      "type": "object",
      "description": "Host insurance verification and coverage metadata. Feeds trust badge and ranking hooks.",
      "properties": {
        "insurance_verified": {
          "type": "boolean",
          "default": false,
          "description": "Admin-verified: host has provided proof of valid property insurance"
        },
        "insurance_document_url": {
          "type": "string",
          "description": "PRIVATE \u2014 admin/host only. URL to uploaded proof-of-insurance document."
        },
        "coverage_notes": {
          "type": "string",
          "description": "Summary of coverage (e.g. 'General liability $1M, filming permitted')"
        },
        "policy_expiry_date": {
          "type": "string",
          "format": "date",
          "description": "When the insurance policy expires \u2014 used to flag re-verification need"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_by_admin_id": {
          "type": "string"
        }
      }
    },
    "host_enforcement": {
      "type": "object",
      "description": "Platform-set enforcement state for this property/host. Written by admins or backend functions only. Never editable by the host.",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "warning",
            "probation",
            "suspended",
            "banned"
          ],
          "default": "none",
          "description": "Current enforcement state for this property's host"
        },
        "no_show_count": {
          "type": "number",
          "default": 0,
          "description": "Number of confirmed host_no_show incidents"
        },
        "cancellation_count": {
          "type": "number",
          "default": 0,
          "description": "Number of host_cancelled incidents (after confirmation)"
        },
        "failed_access_count": {
          "type": "number",
          "default": 0,
          "description": "Number of confirmed failed_access incidents"
        },
        "last_enforcement_action": {
          "type": "string",
          "description": "Last action taken (e.g. 'warning', 'suspended')"
        },
        "enforcement_notes": {
          "type": "string",
          "description": "Admin notes on enforcement history"
        },
        "enforcement_updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "lighting",
              "camera",
              "audio",
              "props",
              "rigging",
              "furniture",
              "specialty",
              "other"
            ],
            "default": "other"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "included": {
            "type": "boolean",
            "default": true
          },
          "rentable": {
            "type": "boolean",
            "default": false
          },
          "rental_price": {
            "type": "number"
          },
          "deposit_required": {
            "type": "boolean",
            "default": false
          },
          "deposit_amount": {
            "type": "number"
          },
          "requires_liability_ack": {
            "type": "boolean",
            "default": false
          },
          "liability_text": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "included_equipment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "price_modifier": {
            "type": "number",
            "default": 0
          },
          "price_modifier_type": {
            "type": "string",
            "enum": [
              "flat",
              "percent"
            ],
            "default": "flat"
          },
          "is_default": {
            "type": "boolean",
            "default": false
          },
          "requires_liability_ack": {
            "type": "boolean",
            "default": false
          },
          "liability_text": {
            "type": "string"
          }
        }
      }
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "max_people": {
          "type": "number"
        },
        "verified_only": {
          "type": "boolean",
          "default": true
        },
        "no_smoking": {
          "type": "boolean",
          "default": true
        },
        "no_alcohol": {
          "type": "boolean",
          "default": false
        },
        "music_allowed": {
          "type": "boolean",
          "default": true
        },
        "quiet_hours_start": {
          "type": "string"
        },
        "quiet_hours_end": {
          "type": "string"
        },
        "no_outside_vendors": {
          "type": "boolean",
          "default": false
        },
        "no_outside_filming_equipment": {
          "type": "boolean",
          "default": false
        },
        "no_window_visibility": {
          "type": "boolean",
          "default": false
        },
        "no_overnight": {
          "type": "boolean",
          "default": true
        },
        "furniture_movement_allowed": {
          "type": "boolean",
          "default": false
        },
        "cleanup_required": {
          "type": "boolean",
          "default": true
        },
        "parking_available": {
          "type": "boolean",
          "default": false
        },
        "parking_notes": {
          "type": "string"
        },
        "security_cameras_present": {
          "type": "boolean",
          "default": false
        },
        "security_camera_notes": {
          "type": "string"
        },
        "equipment_use_allowed": {
          "type": "boolean",
          "default": true
        },
        "equipment_use_notes": {
          "type": "string"
        },
        "restricted_content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "special_restrictions": {
          "type": "string"
        },
        "custom_rules": {
          "type": "string"
        }
      }
    },
    "availability_notes": {
      "type": "string"
    },
    "instant_book": {
      "type": "boolean",
      "default": false
    },
    "onboarding_checklist": {
      "type": "object",
      "properties": {
        "photos_uploaded": {
          "type": "boolean",
          "default": false
        },
        "pricing_set": {
          "type": "boolean",
          "default": false
        },
        "rules_set": {
          "type": "boolean",
          "default": false
        },
        "address_verified": {
          "type": "boolean",
          "default": false
        },
        "agreement_accepted": {
          "type": "boolean",
          "default": false
        },
        "host_doc_uploaded": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "host_doc_uri": {
      "type": "string"
    },
    "agreement_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_bookings": {
      "type": "number",
      "default": 0
    },
    "average_rating": {
      "type": "number",
      "description": "Aggregated from active PropertyReview records"
    },
    "total_reviews": {
      "type": "number",
      "default": 0,
      "description": "Count of active PropertyReview records. Source of truth for review aggregation."
    },
    "recent_review_count": {
      "type": "number",
      "default": 0,
      "description": "Count of active reviews within last 30 days"
    },
    "last_review_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of most recent review (for freshness signal)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "internal_notes": {
      "type": "string"
    },
    "flagged": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "owner_user_id",
    "property_type",
    "title",
    "city",
    "status"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "data.status": "active"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}