{
  "name": "Property",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Platform user who owns/hosts this property"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "individual",
        "studio",
        "agency",
        "production_company"
      ],
      "default": "individual"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "studio",
        "loft",
        "house",
        "apartment",
        "studio_set",
        "dungeon",
        "warehouse",
        "hotel_suite",
        "dedicated_content_house",
        "commercial_space",
        "rooftop",
        "outdoor",
        "office",
        "other"
      ],
      "default": "studio"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "active",
        "paused",
        "suspended",
        "archived"
      ],
      "default": "draft"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "US"
    },
    "exact_address": {
      "type": "string",
      "description": "PRIVATE. Only revealed after confirmed booking."
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "caption": {
            "type": "string"
          },
          "is_cover": {
            "type": "boolean",
            "default": false
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "properties": {
        "max_people": {
          "type": "number"
        },
        "rooms": {
          "type": "number"
        },
        "sq_ft": {
          "type": "number"
        }
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "hourly_rate": {
          "type": "number"
        },
        "half_day_rate": {
          "type": "number"
        },
        "full_day_rate": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "minimum_hours": {
          "type": "number",
          "default": 1
        },
        "deposit_required": {
          "type": "boolean",
          "default": false
        },
        "deposit_amount": {
          "type": "number"
        },
        "pricing_notes": {
          "type": "string"
        },
        "cleaning_fee_enabled": {
          "type": "boolean",
          "default": false
        },
        "cleaning_fee_amount": {
          "type": "number",
          "description": "Flat cleaning fee added to every booking total"
        }
      }
    },
    "buffers": {
      "type": "object",
      "description": "Turnover buffers that block the schedule around every confirmed booking",
      "properties": {
        "setup_buffer_hours": {
          "type": "number",
          "default": 0,
          "description": "Hours blocked before booking start time"
        },
        "teardown_buffer_hours": {
          "type": "number",
          "default": 0,
          "description": "Hours blocked after booking end time"
        },
        "cleaning_buffer_hours": {
          "type": "number",
          "default": 0,
          "description": "Additional hours blocked after teardown for cleaning"
        }
      }
    },
    "equipment": {
      "type": "array",
      "description": "Per-property equipment inventory. Each item can be included, rentable, or both.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client-generated UUID for item identity"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "lighting",
              "camera",
              "audio",
              "props",
              "rigging",
              "furniture",
              "specialty",
              "other"
            ],
            "default": "other"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "included": {
            "type": "boolean",
            "default": true,
            "description": "Available at no extra cost with every booking"
          },
          "rentable": {
            "type": "boolean",
            "default": false,
            "description": "Can be added as a paid add-on"
          },
          "rental_price": {
            "type": "number",
            "description": "Per-booking rental price (ignored when included=true)"
          },
          "deposit_required": {
            "type": "boolean",
            "default": false
          },
          "deposit_amount": {
            "type": "number"
          },
          "requires_liability_ack": {
            "type": "boolean",
            "default": false,
            "description": "Guest must explicitly acknowledge liability before renting"
          },
          "liability_text": {
            "type": "string",
            "description": "Liability disclosure shown to guest at booking"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "bundles": {
      "type": "array",
      "description": "Package templates the host offers. Guest picks one bundle at booking time.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "e.g. Space Only, Production-Ready, Dungeon Package"
          },
          "description": {
            "type": "string"
          },
          "included_equipment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IDs from equipment[] that are included in this bundle"
          },
          "price_modifier": {
            "type": "number",
            "default": 0,
            "description": "Flat amount added on top of base space rate. Negative = discount."
          },
          "price_modifier_type": {
            "type": "string",
            "enum": [
              "flat",
              "percent"
            ],
            "default": "flat"
          },
          "is_default": {
            "type": "boolean",
            "default": false,
            "description": "Pre-selected for new bookings"
          },
          "requires_liability_ack": {
            "type": "boolean",
            "default": false
          },
          "liability_text": {
            "type": "string"
          }
        }
      }
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "max_people": {
          "type": "number"
        },
        "verified_only": {
          "type": "boolean",
          "default": true
        },
        "no_smoking": {
          "type": "boolean",
          "default": true
        },
        "no_alcohol": {
          "type": "boolean",
          "default": false
        },
        "music_allowed": {
          "type": "boolean",
          "default": true
        },
        "quiet_hours_start": {
          "type": "string"
        },
        "quiet_hours_end": {
          "type": "string"
        },
        "no_outside_vendors": {
          "type": "boolean",
          "default": false
        },
        "no_outside_filming_equipment": {
          "type": "boolean",
          "default": false
        },
        "no_window_visibility": {
          "type": "boolean",
          "default": false
        },
        "no_overnight": {
          "type": "boolean",
          "default": true
        },
        "furniture_movement_allowed": {
          "type": "boolean",
          "default": false
        },
        "cleanup_required": {
          "type": "boolean",
          "default": true
        },
        "parking_available": {
          "type": "boolean",
          "default": false
        },
        "parking_notes": {
          "type": "string"
        },
        "security_cameras_present": {
          "type": "boolean",
          "default": false
        },
        "security_camera_notes": {
          "type": "string"
        },
        "equipment_use_allowed": {
          "type": "boolean",
          "default": true
        },
        "equipment_use_notes": {
          "type": "string"
        },
        "restricted_content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "special_restrictions": {
          "type": "string"
        },
        "custom_rules": {
          "type": "string"
        }
      }
    },
    "availability_notes": {
      "type": "string"
    },
    "instant_book": {
      "type": "boolean",
      "default": false
    },
    "onboarding_checklist": {
      "type": "object",
      "properties": {
        "photos_uploaded": {
          "type": "boolean",
          "default": false
        },
        "pricing_set": {
          "type": "boolean",
          "default": false
        },
        "rules_set": {
          "type": "boolean",
          "default": false
        },
        "address_verified": {
          "type": "boolean",
          "default": false
        },
        "agreement_accepted": {
          "type": "boolean",
          "default": false
        },
        "host_doc_uploaded": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "host_doc_uri": {
      "type": "string"
    },
    "agreement_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_bookings": {
      "type": "number",
      "default": 0
    },
    "average_rating": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "internal_notes": {
      "type": "string"
    },
    "flagged": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "owner_user_id",
    "property_type",
    "title",
    "city",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "data.status": "active"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}