{
  "name": "FriendActivityLog",
  "type": "object",
  "properties": {
    "actor_user_id": {
      "type": "string",
      "description": "User who performed the action"
    },
    "target_user_id": {
      "type": "string",
      "description": "User who was targeted"
    },
    "friendship_id": {
      "type": "string",
      "description": "Reference to Friendship record"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "REQUEST_SENT",
        "REQUEST_ACCEPTED",
        "REQUEST_DECLINED",
        "REQUEST_CANCELLED",
        "REQUEST_BLOCKED"
      ],
      "description": "Type of action"
    },
    "reason": {
      "type": "string",
      "description": "Reason for the action"
    },
    "metadata_json": {
      "type": "object",
      "description": "Additional metadata"
    }
  },
  "required": [
    "actor_user_id",
    "target_user_id",
    "action_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.actor_user_id": "{{user.email}}"
        },
        {
          "data.target_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.actor_user_id": "{{user.email}}"
        },
        {
          "data.target_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {},
    "delete": {}
  }
}