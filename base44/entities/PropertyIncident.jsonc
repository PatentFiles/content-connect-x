{
  "name": "PropertyIncident",
  "type": "object",
  "description": "Incident report for a property booking \u2014 damage, safety issues, unauthorized use, etc. Extends existing AdminActionLog/Report moderation patterns. Admin-reviewed, not a standalone claims system.",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "SoloSession this incident occurred during"
    },
    "property_id": {
      "type": "string",
      "description": "Property where the incident occurred"
    },
    "reporter_user_id": {
      "type": "string",
      "description": "User who filed the incident (host or guest)"
    },
    "reporter_role": {
      "type": "string",
      "enum": [
        "host",
        "guest"
      ],
      "description": "Role of the reporter in this session"
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "damage",
        "unauthorized_use",
        "safety_issue",
        "illegal_activity",
        "cleanup_failure",
        "equipment_issue",
        "host_no_show",
        "host_cancelled",
        "failed_access",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "description": "Short incident summary"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what occurred"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photo/video evidence URLs (uploaded via Core.UploadFile)"
    },
    "estimated_damage_amount": {
      "type": "number",
      "description": "Host-estimated damage cost in USD (for damage incidents only)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "resolved",
        "dismissed",
        "escalated"
      ],
      "default": "open",
      "description": "Admin review status \u2014 same lifecycle as Report entity"
    },
    "admin_notes": {
      "type": "string"
    },
    "admin_reviewer_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution": {
      "type": "string",
      "enum": [
        "no_action",
        "warning_issued",
        "deposit_withheld",
        "payout_adjusted",
        "suspended",
        "banned",
        "referred_to_insurance"
      ],
      "description": "What action was taken on resolution"
    },
    "deposit_withheld_amount": {
      "type": "number",
      "description": "If deposit was withheld, how much (admin set)"
    },
    "linked_report_id": {
      "type": "string",
      "description": "ID of a linked Report record if escalated to the broader moderation queue"
    },
    "linked_booking_access_event_id": {
      "type": "string",
      "description": "ID of the BookingAccessEvent that triggered or corroborates this incident"
    }
  },
  "required": [
    "session_id",
    "property_id",
    "reporter_user_id",
    "reporter_role",
    "incident_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.reporter_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.reporter_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}