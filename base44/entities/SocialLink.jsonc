{
  "name": "SocialLink",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "platform_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "normalized_value": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "VERIFIED_ONLY",
        "MATCHED_ONLY",
        "DEAL_ROOM_ONLY",
        "PRIVATE"
      ],
      "default": "VERIFIED_ONLY"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "platform_id",
    "value"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "data.visibility": "PUBLIC"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.email}}"
    },
    "delete": {
      "data.user_id": "{{user.email}}"
    }
  }
}