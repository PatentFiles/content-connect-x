{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "requester_user_id": {
      "type": "string",
      "description": "User who sent the friend request"
    },
    "addressee_user_id": {
      "type": "string",
      "description": "User who received the friend request"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACCEPTED",
        "DECLINED",
        "CANCELLED"
      ],
      "default": "PENDING",
      "description": "Current status of the friendship"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was sent"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was responded to"
    },
    "last_interaction_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last interaction timestamp"
    },
    "dm_thread_id": {
      "type": "string",
      "description": "Reference to the DM conversation"
    },
    "gating_mode_at_request": {
      "type": "string",
      "enum": [
        "MESSAGE_FIRST",
        "EVERYONE_ALLOWED"
      ],
      "description": "Policy mode when request was sent"
    },
    "decline_cooldown_until": {
      "type": "string",
      "format": "date-time",
      "description": "Cooldown period after decline"
    }
  },
  "required": [
    "requester_user_id",
    "addressee_user_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.requester_user_id": "{{user.email}}"
        },
        {
          "data.addressee_user_id": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.requester_user_id": "{{user.email}}"
        },
        {
          "data.addressee_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requester_user_id": "{{user.email}}"
        },
        {
          "data.addressee_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.requester_user_id": "{{user.email}}"
        },
        {
          "data.addressee_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}