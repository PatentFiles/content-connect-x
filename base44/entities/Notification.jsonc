{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Recipient user ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "messages",
        "collaboration_invites",
        "role_changes",
        "contract_updates",
        "testing_deadlines",
        "dispute_updates",
        "representation_actions",
        "verification_status",
        "system_announcements"
      ],
      "description": "Notification type matching NotificationPreference types"
    },
    "actor_user_id": {
      "type": "string",
      "description": "User who triggered the notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "body": {
      "type": "string",
      "description": "Notification message body"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When notification was read"
    },
    "related_entity_type": {
      "type": "string",
      "description": "Related entity type (e.g., Collaboration, Contract)"
    },
    "related_entity_id": {
      "type": "string",
      "description": "Related entity ID"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate when clicked"
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "body"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}