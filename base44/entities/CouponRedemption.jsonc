{
  "name": "CouponRedemption",
  "type": "object",
  "properties": {
    "coupon_id": {
      "type": "string"
    },
    "coupon_code": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "subscription_id": {
      "type": "string"
    },
    "discount_applied": {
      "type": "number"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "coupon_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}