{
  "name": "CustomValueSubmission",
  "type": "object",
  "properties": {
    "submitted_by": {
      "type": "string",
      "description": "User who submitted"
    },
    "category": {
      "type": "string",
      "enum": [
        "scene_pairing",
        "standard_act",
        "fetish_act",
        "kink_edge_act",
        "performance_positioning"
      ],
      "description": "Category of custom value"
    },
    "custom_value": {
      "type": "string",
      "description": "Custom value submitted"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reviewed"
    }
  },
  "required": [
    "submitted_by",
    "category",
    "custom_value"
  ],
  "rls": {
    "create": {
      "data.submitted_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.submitted_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}