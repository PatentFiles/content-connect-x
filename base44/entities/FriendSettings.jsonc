{
  "name": "FriendSettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "friend_request_policy": {
      "type": "string",
      "enum": [
        "EVERYONE",
        "MESSAGE_FIRST",
        "NO_ONE"
      ],
      "default": "MESSAGE_FIRST",
      "description": "Who can send friend requests"
    },
    "allow_collaboration_invites_non_friends": {
      "type": "boolean",
      "default": false,
      "description": "Allow collaboration invites from non-friends"
    },
    "friend_count_visibility": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "VERIFIED_ONLY",
        "PRIVATE"
      ],
      "default": "PUBLIC",
      "description": "Who can see friend count"
    },
    "friend_request_daily_limit": {
      "type": "number",
      "default": 10,
      "description": "Daily friend request limit"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}