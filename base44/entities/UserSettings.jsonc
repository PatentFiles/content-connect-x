{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "notifications": {
      "type": "object",
      "properties": {
        "new_messages": {
          "type": "boolean",
          "default": true
        },
        "deal_room_updates": {
          "type": "boolean",
          "default": true
        },
        "contract_signatures": {
          "type": "boolean",
          "default": true
        },
        "profile_views": {
          "type": "boolean",
          "default": true
        },
        "marketing": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "privacy": {
      "type": "object",
      "properties": {
        "message_requests_approval": {
          "type": "boolean",
          "default": false
        },
        "show_online_status": {
          "type": "boolean",
          "default": true
        },
        "show_location": {
          "type": "boolean",
          "default": true
        },
        "profile_visibility": {
          "type": "string",
          "enum": [
            "verified_members",
            "subscribers_only"
          ],
          "default": "verified_members"
        },
        "friends_only_profile": {
          "type": "boolean",
          "default": false
        },
        "show_gallery_count": {
          "type": "boolean",
          "default": true
        },
        "gallery_comment_policy": {
          "type": "string",
          "enum": [
            "everyone",
            "friends_only",
            "no_one"
          ],
          "default": "everyone"
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "two_factor_enabled": {
          "type": "boolean",
          "default": false
        },
        "two_factor_secret": {
          "type": "string"
        },
        "password_changed_at": {
          "type": "string",
          "format": "date-time"
        },
        "force_password_reset": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.user_id": "{{user.email}}"
    }
  }
}