{
  "name": "PricingTier",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "role_type": {
      "type": "string",
      "enum": [
        "creator",
        "photographer",
        "videographer",
        "agent",
        "studio"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "pro",
        "elite",
        "enterprise"
      ]
    },
    "price_monthly": {
      "type": "number"
    },
    "price_yearly": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "messages_per_day": {
          "type": "number"
        },
        "deal_rooms_per_month": {
          "type": "number"
        },
        "gallery_items": {
          "type": "number"
        },
        "shortlists": {
          "type": "number"
        }
      }
    },
    "stripe_payment_link_monthly": {
      "type": "string",
      "description": "Stripe Payment Link URL for monthly billing"
    },
    "stripe_payment_link_yearly": {
      "type": "string",
      "description": "Stripe Payment Link URL for yearly billing"
    },
    "stripe_price_id_monthly": {
      "type": "string",
      "description": "Stripe Price ID for monthly (for Checkout sessions when backend enabled)"
    },
    "stripe_price_id_yearly": {
      "type": "string",
      "description": "Stripe Price ID for yearly (for Checkout sessions when backend enabled)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "plan_id",
    "name",
    "role_type",
    "tier"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}