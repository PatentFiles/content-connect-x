{
  "name": "Contract",
  "type": "object",
  "properties": {
    "collaboration_id": {
      "type": "string",
      "description": "Reference to collaboration"
    },
    "template_id": {
      "type": "string",
      "description": "Contract template used"
    },
    "title": {
      "type": "string",
      "description": "Contract title"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "creator_to_creator",
        "studio_contract",
        "photographer_contract",
        "videographer_contract",
        "agent_managed",
        "custom"
      ],
      "default": "custom"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "sent",
        "partially_signed",
        "signed",
        "completed",
        "disputed",
        "expired",
        "voided"
      ],
      "default": "draft",
      "description": "Contract lifecycle status"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Current version number"
    },
    "current_version_id": {
      "type": "string",
      "description": "ID of current ContractVersion"
    },
    "content": {
      "type": "object",
      "description": "Legacy contract details and terms"
    },
    "created_by": {
      "type": "string",
      "description": "User who created contract"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When contract was sent for signatures"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Contract effective date"
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Optional renewal date"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Contract expiration date"
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role_type": {
            "type": "string",
            "enum": [
              "creator",
              "studio",
              "producer",
              "agent",
              "photographer",
              "videographer"
            ]
          },
          "legal_name": {
            "type": "string"
          },
          "stage_name": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "description": "Contract parties with full details"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "performers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "boundaries": {
            "type": "object"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Scene details from collaboration"
    },
    "post_scene_rules": {
      "type": "object",
      "properties": {
        "editing_rules": {
          "type": "string"
        },
        "posting_rules": {
          "type": "string"
        },
        "ownership_model": {
          "type": "string"
        },
        "ownership_split": {
          "type": "object"
        },
        "revenue_split": {
          "type": "object"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "embargo_until": {
          "type": "string",
          "format": "date"
        },
        "takedown_policy": {
          "type": "string"
        },
        "crediting_rules": {
          "type": "string"
        },
        "ai_use_policy": {
          "type": "string"
        }
      },
      "description": "Post-scene content rules"
    },
    "pdf_url": {
      "type": "string",
      "description": "Final signed PDF URL"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When all signatures were collected"
    },
    "signed_version_hash": {
      "type": "string",
      "description": "Hash of signed contract version"
    },
    "signatories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "signed": {
            "type": "boolean",
            "default": false
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Legacy signatory tracking"
    }
  },
  "required": [
    "collaboration_id",
    "title",
    "created_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}