{
  "name": "CollaborationConfirmation",
  "type": "object",
  "properties": {
    "collaboration_id": {
      "type": "string",
      "description": "DealRoom collaboration ID"
    },
    "user_id": {
      "type": "string",
      "description": "User submitting confirmation"
    },
    "scene_completed_as_agreed": {
      "type": "boolean",
      "description": "Whether scene was completed as agreed"
    },
    "issues_encountered": {
      "type": "string",
      "description": "Optional notes on any issues"
    },
    "consent_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Consent acknowledgment"
    },
    "confirmation_date": {
      "type": "string",
      "format": "date-time",
      "description": "When confirmation was submitted"
    }
  },
  "required": [
    "collaboration_id",
    "user_id",
    "scene_completed_as_agreed",
    "consent_acknowledged"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.email}}"
    },
    "delete": {
      "data.user_id": "{{user.email}}"
    }
  }
}