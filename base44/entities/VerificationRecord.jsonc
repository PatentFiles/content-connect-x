{
  "name": "VerificationRecord",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "yoti",
        "passbase",
        "manual",
        "other"
      ],
      "description": "KYC verification provider"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Provider-specific verification data"
    },
    "documents_submitted": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Document type (e.g. 'id', 'selfie')"
          },
          "uri": {
            "type": "string",
            "description": "Private storage URI. Use getSecureDocumentUrl to get a short-lived signed URL. Never a public URL."
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "user_id",
    "provider",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
