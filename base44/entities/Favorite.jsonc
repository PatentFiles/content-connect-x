{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "description": "Favorited user profiles",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "property_items": {
      "type": "array",
      "description": "Favorited host properties \u2014 extended in-place, separate from user items. Soft-deleted properties are kept with available=false.",
      "items": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          },
          "available": {
            "type": "boolean",
            "default": true,
            "description": "Set false when property is deleted/suspended/archived. Record is kept, not hard-deleted."
          },
          "unavailable_reason": {
            "type": "string",
            "enum": [
              "deleted",
              "suspended",
              "archived",
              "paused"
            ],
            "description": "Why the property is no longer available"
          }
        }
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "owner_id",
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.owner_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.owner_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.owner_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    }
  }
}