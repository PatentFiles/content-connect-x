{
  "name": "ContentUsageRecord",
  "type": "object",
  "description": "Tracks where, when, and how content produced in a session or collaboration has been published/used. Supports compliance review, takedown requests, and dispute evidence. Additive \u2014 does not replace Contract.post_scene_rules.",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "SoloSession the content was produced in (if applicable)"
    },
    "collaboration_id": {
      "type": "string",
      "description": "Collaboration the content was produced in (if applicable)"
    },
    "contract_id": {
      "type": "string",
      "description": "Contract that governs this content's usage rights"
    },
    "reported_by_user_id": {
      "type": "string",
      "description": "User who filed this usage record"
    },
    "platform_or_url": {
      "type": "string",
      "description": "Platform name or URL where content was published (e.g. 'OnlyFans', 'https://example.com/...')"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "photo",
        "video",
        "clip",
        "reel",
        "post",
        "advertisement",
        "other"
      ],
      "description": "Type of content published"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the content was published"
    },
    "usage_type": {
      "type": "string",
      "enum": [
        "authorized_self_publish",
        "authorized_third_party",
        "disputed_unauthorized",
        "takedown_requested",
        "takedown_confirmed",
        "within_embargo",
        "post_embargo",
        "licensed_commercial"
      ],
      "description": "Whether this usage is authorized, disputed, or under a takedown"
    },
    "contract_clause_reference": {
      "type": "string",
      "description": "Free-text reference to the specific contract clause authorizing or governing this usage"
    },
    "notes": {
      "type": "string",
      "description": "Additional context from the reporting user"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Screenshots or links uploaded as evidence of publication"
    },
    "status": {
      "type": "string",
      "enum": [
        "logged",
        "under_review",
        "resolved",
        "escalated"
      ],
      "default": "logged",
      "description": "Admin review status"
    },
    "admin_notes": {
      "type": "string"
    },
    "admin_reviewer_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_dispute_id": {
      "type": "string",
      "description": "CollaborationDispute ID if this record was escalated"
    }
  },
  "required": [
    "reported_by_user_id",
    "usage_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.reported_by_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.reported_by_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.reported_by_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}