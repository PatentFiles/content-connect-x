{
  "name": "StudioDetails",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "studio_name": {
      "type": "string"
    },
    "content_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gay",
          "straight",
          "trans"
        ]
      },
      "description": "Types of content they film"
    },
    "website": {
      "type": "string",
      "description": "Studio website URL"
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "styles_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "staff_seats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contract_templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "booking_email": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "studio_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}