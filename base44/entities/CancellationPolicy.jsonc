{
  "name": "CancellationPolicy",
  "type": "object",
  "description": "Host-defined or platform-default cancellation policy, attachable to a Property. Supports preset tiers (flexible/moderate/strict/custom) with full refund window, credit, no-show, and damage deposit linkage logic.",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Host who owns this policy. Null = platform default."
    },
    "property_id": {
      "type": "string",
      "description": "Property this policy is attached to (null = user-level default)"
    },
    "preset": {
      "type": "string",
      "enum": [
        "flexible",
        "moderate",
        "strict",
        "custom"
      ],
      "default": "moderate",
      "description": "Policy tier. 'custom' allows full overrides."
    },
    "label": {
      "type": "string",
      "description": "Display name, e.g. 'Flexible \u2014 Full refund 24h before'"
    },
    "description": {
      "type": "string",
      "description": "Human-readable summary shown to guests before booking"
    },
    "guest_cancellation": {
      "type": "object",
      "description": "Rules governing guest-initiated cancellations",
      "properties": {
        "full_refund_hours_before": {
          "type": "number",
          "description": "Hours before session start within which guest gets a full refund. 0 = no full refund."
        },
        "partial_refund_hours_before": {
          "type": "number",
          "description": "Hours before start within which guest gets a partial refund"
        },
        "partial_refund_pct": {
          "type": "number",
          "description": "Percentage of booking total refunded in the partial window (e.g. 50)"
        },
        "no_refund_hours_before": {
          "type": "number",
          "description": "Within this many hours of start, no refund is issued"
        },
        "credit_instead_of_refund": {
          "type": "boolean",
          "default": false,
          "description": "Issue platform credit instead of cash refund"
        },
        "credit_valid_days": {
          "type": "number",
          "description": "Days the issued credit is valid for"
        },
        "cleaning_fee_refundable": {
          "type": "boolean",
          "default": false,
          "description": "Whether the cleaning fee is included in any refund"
        }
      }
    },
    "host_cancellation": {
      "type": "object",
      "description": "Consequences when a host cancels a confirmed booking",
      "properties": {
        "guest_full_refund": {
          "type": "boolean",
          "default": true,
          "description": "Guest always receives a full refund when host cancels"
        },
        "host_penalty_applies": {
          "type": "boolean",
          "default": true,
          "description": "Host incurs a cancellation strike / enforcement consequence"
        },
        "penalty_description": {
          "type": "string",
          "description": "Text description of host penalty shown in policy disclosure"
        }
      }
    },
    "no_show_policy": {
      "type": "object",
      "description": "What happens when a guest or host fails to appear",
      "properties": {
        "guest_no_show_refund_pct": {
          "type": "number",
          "default": 0,
          "description": "Percentage refunded to a no-show guest (typically 0)"
        },
        "host_no_show_guest_refund_pct": {
          "type": "number",
          "default": 100,
          "description": "Percentage refunded to guest when host no-shows (typically 100)"
        },
        "host_no_show_creates_incident": {
          "type": "boolean",
          "default": true,
          "description": "Automatically creates a PropertyIncident on host no-show"
        }
      }
    },
    "damage_deposit_linkage": {
      "type": "object",
      "description": "How damage deposit interacts with cancellation refunds",
      "properties": {
        "deposit_refundable_on_guest_cancel": {
          "type": "boolean",
          "default": true,
          "description": "Damage deposit is returned if guest cancels within full-refund window"
        },
        "deposit_withheld_on_no_show": {
          "type": "boolean",
          "default": false,
          "description": "Whether damage deposit can be withheld on guest no-show"
        }
      }
    },
    "policy_text_snapshot": {
      "type": "string",
      "description": "Auto-generated or admin-authored policy text shown to guests and stored at booking time"
    },
    "is_platform_default": {
      "type": "boolean",
      "default": false,
      "description": "Admin-created defaults visible to all hosts as presets"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Increment when policy terms change \u2014 booking snapshots reference the version at booking time"
    }
  },
  "required": [
    "preset"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "data.is_platform_default": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}