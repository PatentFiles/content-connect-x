{
  "name": "ScheduleEntry",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who owns this schedule entry"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "AVAILABILITY",
        "TRAVEL",
        "BOOKING",
        "EXTERNAL_BUSY"
      ],
      "description": "Type of schedule entry"
    },
    "status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "BOOKED"
      ],
      "description": "Availability status for this time slot"
    },
    "source": {
      "type": "string",
      "enum": [
        "MANUAL",
        "TRAVEL",
        "COLLABORATION",
        "EXTERNAL_CALENDAR"
      ],
      "description": "How this entry was created"
    },
    "collaboration_id": {
      "type": "string",
      "description": "Reference to collaboration if booked"
    },
    "title": {
      "type": "string",
      "description": "Optional title for the entry"
    },
    "location_city": {
      "type": "string",
      "description": "City where entry takes place"
    },
    "location_region": {
      "type": "string",
      "description": "State/region"
    },
    "location_country": {
      "type": "string",
      "description": "Country"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "STUDIO",
        "PRIVATE",
        "NONE"
      ],
      "description": "Type of location"
    },
    "location_name": {
      "type": "string",
      "description": "Name of venue/location"
    },
    "location_address": {
      "type": "string",
      "description": "Full address"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of entry"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of entry"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM format)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM format)"
    },
    "timezone": {
      "type": "string",
      "description": "Timezone for the entry"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Whether entry can be modified"
    },
    "lock_reason": {
      "type": "string",
      "description": "Reason for locking if applicable"
    },
    "external_provider": {
      "type": "string",
      "description": "External calendar provider (e.g., google, apple)"
    },
    "external_event_id": {
      "type": "string",
      "description": "ID from external calendar system"
    },
    "room_label": {
      "type": "string",
      "description": "Studio: room or set name (e.g. 'Main Set A', 'Cyc Room')"
    },
    "equipment_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Studio: equipment/features available during this window (e.g. 'Lighting rig', '4K cameras')"
    },
    "booking_notes": {
      "type": "string",
      "description": "Studio: conditions, deposit requirements, rules for this availability window"
    },
    "max_bookings": {
      "type": "number",
      "description": "Studio: max simultaneous bookings for this window (default 1)"
    },
    "current_booking_count": {
      "type": "number",
      "default": 0,
      "description": "Studio: how many bookings are currently accepted against this window"
    }
  },
  "required": [
    "user_id",
    "entry_type",
    "status",
    "source",
    "start_date",
    "end_date",
    "timezone"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}