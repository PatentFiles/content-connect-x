{
  "name": "BannedReentryDispute",
  "type": "object",
  "properties": {
    "submitter_user_id": {
      "type": "string",
      "description": "The new account user_id that submitted this dispute"
    },
    "prior_banned_user_id": {
      "type": "string",
      "description": "The previously banned user_id detected via identity consistency match"
    },
    "identity_flag_id": {
      "type": "string",
      "description": "ID of the IdentityConsistencyFlag that triggered this dispute"
    },
    "dispute_statement": {
      "type": "string",
      "description": "User's explanation and request for reinstatement"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "approved",
        "approved_probation",
        "denied",
        "more_info_requested"
      ],
      "default": "pending",
      "description": "Admin review status"
    },
    "admin_decision": {
      "type": "string",
      "description": "Admin's detailed written decision"
    },
    "admin_reviewer_id": {
      "type": "string",
      "description": "Admin who reviewed this dispute"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "probation_config": {
      "type": "object",
      "description": "Probation restrictions to apply if approved_probation",
      "properties": {
        "restricted_messaging": {
          "type": "boolean"
        },
        "no_hosting": {
          "type": "boolean"
        },
        "no_accelerated_payouts": {
          "type": "boolean"
        },
        "elevated_moderation": {
          "type": "boolean"
        },
        "probation_end_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "more_info_request": {
      "type": "string",
      "description": "What additional information admin has requested from the user"
    },
    "supplemental_statement": {
      "type": "string",
      "description": "User's follow-up statement after more info was requested"
    }
  },
  "required": [
    "submitter_user_id",
    "dispute_statement"
  ],
  "rls": {
    "create": {
      "data.submitter_user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.submitter_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.submitter_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}