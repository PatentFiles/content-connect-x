{
  "name": "ContractVersion",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "Parent contract ID"
    },
    "version_number": {
      "type": "number",
      "description": "Version sequence number"
    },
    "body_markdown": {
      "type": "string",
      "description": "Contract content in markdown"
    },
    "body_html": {
      "type": "string",
      "description": "Contract content in HTML"
    },
    "structured_snapshot": {
      "type": "object",
      "properties": {
        "parties": {
          "type": "array"
        },
        "scenes": {
          "type": "array"
        },
        "post_scene_rules": {
          "type": "object"
        },
        "collaboration_meta": {
          "type": "object"
        }
      },
      "description": "Immutable snapshot of structured data"
    },
    "created_by": {
      "type": "string",
      "description": "User who created this version"
    },
    "change_summary": {
      "type": "string",
      "description": "Description of changes made"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "True when contract is signed and immutable"
    }
  },
  "required": [
    "contract_id",
    "version_number",
    "body_html",
    "created_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.is_locked": false
        },
        {
          "$or": [
            {
              "data.created_by": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}