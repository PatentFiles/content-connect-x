{
  "name": "PropertyReview",
  "type": "object",
  "description": "Review of a property by a verified guest who completed a booking/session. Strictly tied to completed bookings. Includes recency and integrity tracking.",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Property being reviewed"
    },
    "session_id": {
      "type": "string",
      "description": "Completed session that qualifies the review"
    },
    "reviewer_user_id": {
      "type": "string",
      "description": "User who completed the booking and is reviewing"
    },
    "reviewer_role_type": {
      "type": "string",
      "enum": [
        "creator",
        "photographer",
        "videographer",
        "video_editor",
        "agent",
        "studio",
        "admin"
      ],
      "description": "Role type of reviewer (cached from UserProfile for badge display)"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating 1-5"
    },
    "review_text": {
      "type": "string",
      "description": "Review content (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden",
        "removed"
      ],
      "default": "active",
      "description": "Review visibility status"
    },
    "verified": {
      "type": "boolean",
      "default": true,
      "description": "Always true if created through eligibility check (immutable)"
    },
    "review_integrity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1.0,
      "description": "Integrity score 0-1: 1.0=trusted, 0.5=suspicious, 0.0=ignore in ranking. Admin-set or auto-computed."
    },
    "integrity_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Auto-detected flags: rapid_review_burst, abnormal_rating_pattern, user_review_velocity. Used for integrity audit."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Immutable creation timestamp for recency weighting"
    }
  },
  "required": [
    "property_id",
    "session_id",
    "reviewer_user_id",
    "rating"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.reviewer_user_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "data.reviewer_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.reviewer_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}