{
  "name": "PropertyReview",
  "type": "object",
  "description": "Review of a property by a verified guest who completed a booking/session. Strictly tied to completed bookings.",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Property being reviewed"
    },
    "session_id": {
      "type": "string",
      "description": "Completed SoloSession that qualifies the review"
    },
    "reviewer_user_id": {
      "type": "string",
      "description": "User who completed the booking and is reviewing"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating 1-5"
    },
    "review_text": {
      "type": "string",
      "description": "Review content (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden",
        "removed"
      ],
      "default": "active",
      "description": "Review visibility status"
    },
    "verified": {
      "type": "boolean",
      "default": true,
      "description": "Always true if created through eligibility check (immutable)"
    }
  },
  "required": [
    "property_id",
    "session_id",
    "reviewer_user_id",
    "rating"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.reviewer_user_id": "{{user.email}}"
        },
        {
          "not": {
            "has_banned_or_suspended": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "data.reviewer_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.reviewer_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}