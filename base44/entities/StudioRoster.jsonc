{
  "name": "StudioRoster",
  "type": "object",
  "properties": {
    "studio_user_id": {
      "type": "string",
      "description": "Studio's user ID"
    },
    "creator_user_id": {
      "type": "string",
      "description": "Creator's user ID"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "WORKED_WITH",
        "ROSTER",
        "EXCLUSIVE"
      ],
      "default": "WORKED_WITH",
      "description": "Type of relationship"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "ENDED"
      ],
      "default": "PENDING",
      "description": "Roster status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "studio_user_id",
    "creator_user_id",
    "relationship_type",
    "status"
  ],
  "rls": {
    "create": {
      "data.studio_user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.studio_user_id": "{{user.email}}"
        },
        {
          "data.creator_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.studio_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.studio_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}