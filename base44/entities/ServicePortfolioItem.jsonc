{
  "name": "ServicePortfolioItem",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Service provider's user ID"
    },
    "media_url": {
      "type": "string",
      "description": "Portfolio item URL"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image",
      "description": "Media type"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail URL"
    },
    "title": {
      "type": "string",
      "description": "Item title"
    },
    "description": {
      "type": "string",
      "description": "Item description"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Portrait",
          "Studio",
          "Outdoor",
          "BTS",
          "Cinematic",
          "Documentary",
          "Social",
          "Promo"
        ]
      },
      "description": "Content categories"
    },
    "creator_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Straight",
          "Gay",
          "Lesbian",
          "Bisexual",
          "Trans Male",
          "Trans Female"
        ]
      },
      "description": "Creator types served"
    },
    "location_city": {
      "type": "string"
    },
    "location_state": {
      "type": "string"
    },
    "location_country": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured portfolio item"
    },
    "custom_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags for discoverability"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "user_id",
    "media_url",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}