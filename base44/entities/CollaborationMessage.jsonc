{
  "name": "CollaborationMessage",
  "type": "object",
  "properties": {
    "collaboration_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "system"
      ],
      "default": "text"
    },
    "file_url": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "collaboration_id",
    "sender_id",
    "message"
  ],
  "rls": {
    "create": {
      "data.sender_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.sender_id": "{{user.email}}"
    },
    "delete": {
      "data.sender_id": "{{user.email}}"
    }
  }
}