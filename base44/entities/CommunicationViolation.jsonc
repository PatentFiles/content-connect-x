{
  "name": "CommunicationViolation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who attempted the violation"
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation where the violation occurred"
    },
    "violation_type": {
      "type": "string",
      "enum": [
        "phone_number",
        "email_address",
        "external_link",
        "obfuscated_phone",
        "obfuscated_email",
        "obfuscated_link",
        "multiple"
      ],
      "description": "Type of off-platform sharing detected"
    },
    "message_snippet": {
      "type": "string",
      "description": "Redacted/truncated snippet of the blocked message (no full content stored)"
    },
    "attempt_count": {
      "type": "number",
      "default": 1,
      "description": "Total number of violations by this user (cumulative)"
    },
    "escalation_level": {
      "type": "string",
      "enum": [
        "warn",
        "restrict",
        "flag_admin"
      ],
      "default": "warn",
      "description": "Current enforcement level for this user"
    },
    "admin_reviewed": {
      "type": "boolean",
      "default": false,
      "description": "Whether an admin has reviewed this violation"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin review notes"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "conversation_id",
    "violation_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}