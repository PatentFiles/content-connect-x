{
  "name": "IdentityConsistencyFlag",
  "type": "object",
  "properties": {
    "flagged_user_id": {
      "type": "string",
      "description": "The user being flagged"
    },
    "matched_user_id": {
      "type": "string",
      "description": "The other user whose identity overlaps (if applicable)"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Detection confidence level"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "name_hash_match",
          "name_phonetic_match",
          "dob_hash_match",
          "doc_type_plus_name_match",
          "repeated_rejections",
          "resubmit_after_ban",
          "rapid_resubmission",
          "multiple_accounts_same_identity"
        ]
      },
      "description": "Machine-generated match signals"
    },
    "match_details": {
      "type": "string",
      "description": "Admin-readable explanation. Does NOT contain raw identity values."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewed",
        "escalated",
        "cleared",
        "actioned"
      ],
      "default": "open"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin review notes"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin user ID who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_taken": {
      "type": "string",
      "enum": [
        "none",
        "cleared_false_positive",
        "suspended",
        "banned",
        "legal_hold_added",
        "enhanced_review"
      ],
      "default": "none"
    },
    "triggered_by": {
      "type": "string",
      "description": "What event triggered the flag: verification_approved, verification_rejected, manual_scan"
    }
  },
  "required": [
    "flagged_user_id",
    "confidence",
    "reason_codes"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}