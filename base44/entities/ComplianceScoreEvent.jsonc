{
  "name": "ComplianceScoreEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who triggered this event"
    },
    "score_type": {
      "type": "string",
      "enum": [
        "TESTING_COMPLIANCE"
      ],
      "description": "Type of compliance score"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "MISSED_TESTING_DEADLINE"
      ],
      "description": "Specific event that occurred"
    },
    "collaboration_id": {
      "type": "string",
      "description": "Related collaboration"
    },
    "points": {
      "type": "number",
      "description": "Points awarded or deducted (negative allowed)"
    },
    "note": {
      "type": "string",
      "description": "Additional context for the event"
    }
  },
  "required": [
    "user_id",
    "score_type",
    "event_type",
    "collaboration_id",
    "points"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}