{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "messages",
        "collaboration_invites",
        "role_changes",
        "contract_updates",
        "testing_deadlines",
        "dispute_updates",
        "representation_actions",
        "verification_status",
        "system_announcements"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "channels": {
      "type": "object",
      "properties": {
        "in_app": {
          "type": "boolean",
          "default": true
        },
        "email": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": [
    "user_id",
    "notification_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.user_id": "{{user.email}}"
    }
  }
}