{
  "name": "SessionHistory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "login_at": {
      "type": "string",
      "format": "date-time"
    },
    "logout_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspicious_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "session_id",
    "ip_address"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}