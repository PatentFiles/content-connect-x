{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "requester_user_id": {
      "type": "string",
      "description": "User who sent the booking request"
    },
    "recipient_user_id": {
      "type": "string",
      "description": "User who received the booking request"
    },
    "schedule_entry_id": {
      "type": "string",
      "description": "Reference to the ScheduleEntry selected"
    },
    "requested_date": {
      "type": "string",
      "format": "date",
      "description": "Requested date for the booking"
    },
    "requested_time": {
      "type": "string",
      "description": "Requested time (HH:MM)"
    },
    "requested_end_time": {
      "type": "string",
      "description": "Requested end time (HH:MM)"
    },
    "message": {
      "type": "string",
      "description": "Message from requester to recipient"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "cancelled",
        "expired"
      ],
      "default": "pending"
    },
    "response_message": {
      "type": "string",
      "description": "Optional response message from recipient"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    },
    "collaboration_id": {
      "type": "string",
      "description": "Collaboration created from this booking (set on accept for collaboration bookings)"
    },
    "solo_session_id": {
      "type": "string",
      "description": "SoloSession created from this booking (set on accept for solo bookings)"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "creator",
        "studio",
        "photographer",
        "videographer"
      ],
      "default": "creator",
      "description": "Type of booking \u2014 determines downstream collaboration context"
    },
    "booking_mode": {
      "type": "string",
      "enum": [
        "collaboration",
        "solo"
      ],
      "default": "collaboration",
      "description": "collaboration = creates a Collaboration on accept; solo = creates a SoloSession on accept"
    },
    "participant_mode": {
      "type": "string",
      "enum": [
        "on_platform",
        "external",
        "mixed"
      ],
      "default": "on_platform",
      "description": "Whether session participants are all platform users, external, or mixed"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "collaboration",
        "solo_session",
        "service_booking",
        "location_booking"
      ],
      "default": "collaboration",
      "description": "Downstream session type to create on accept"
    },
    "studio_location_name": {
      "type": "string",
      "description": "Studio location/room name selected at booking time"
    },
    "studio_notes": {
      "type": "string",
      "description": "Studio-specific notes or conditions visible to both parties"
    }
  },
  "required": [
    "requester_user_id",
    "recipient_user_id",
    "requested_date",
    "status"
  ],
  "rls": {
    "create": {
      "data.requester_user_id": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.requester_user_id": "{{user.email}}"
        },
        {
          "data.recipient_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requester_user_id": "{{user.email}}"
        },
        {
          "data.recipient_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.requester_user_id": "{{user.email}}"
        },
        {
          "data.recipient_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}