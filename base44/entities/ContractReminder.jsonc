{
  "name": "ContractReminder",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "Contract ID"
    },
    "collaboration_id": {
      "type": "string",
      "description": "Associated collaboration ID"
    },
    "reminder_type": {
      "type": "string",
      "enum": [
        "signature",
        "expiration",
        "renewal"
      ],
      "description": "Type of reminder"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "When reminder should be sent"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reminder was actually sent"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "sent",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Reminder status"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses of recipients"
    },
    "channel": {
      "type": "string",
      "enum": [
        "in_app",
        "email"
      ],
      "default": "in_app",
      "description": "Delivery channel"
    }
  },
  "required": [
    "contract_id",
    "reminder_type",
    "scheduled_for",
    "recipients"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.recipients": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}