{
  "name": "Auto-Create Earnings on Collaboration Completed",
  "description": "When a collaboration reaches 'completed' status, automatically create earnings records for all participants, agents, and studios.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Collaboration"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_create_earnings_on_collaboration_completed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCreateEarnings",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCreateEarnings"
  }
}