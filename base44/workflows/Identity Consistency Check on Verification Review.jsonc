{
  "name": "Identity Consistency Check on Verification Review",
  "description": "Automatically runs identity consistency scan (duplicate detection, phonetic matching, flag creation) whenever a VerificationRecord status changes to approved or rejected.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\" or .trigger.data.status == \"rejected\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "VerificationRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "identity_consistency_check_on_verification_review",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkIdentityConsistency",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkIdentityConsistency"
  }
}